# Social Media MCP Server Configuration
# Copy to .env and fill in your actual API credentials
# IMPORTANT: Never commit .env to Git!

# Facebook
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here

# Instagram (uses Facebook token)
INSTAGRAM_BUSINESS_ID=your_instagram_business_account_id_here

# Twitter (X)
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_user_access_token_here
TWITTER_ACCESS_SECRET=your_user_access_secret_here
